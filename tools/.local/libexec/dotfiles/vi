#!/bin/sh
# Shared profile selection for Zsh and C shell.
set -eu

mode_file="${XDG_STATE_HOME:-$HOME/.local/state}/nvim-mode"
app=nvim-nopack
case "${1:-}" in
--pack | --nopack)
  [ "$1" != --pack ] || app=nvim
  shift
  mkdir -p "$(dirname "$mode_file")"
  printf '%s\n' "$app" >"$mode_file"
  ;;
*)
  if [ -r "$mode_file" ]; then
    IFS= read -r app <"$mode_file" || :
  fi
  ;;
esac
case "$app" in nvim | nvim-nopack) ;; *) app=nvim-nopack ;; esac
exec env NVIM_APPNAME="$app" nvim "$@"
